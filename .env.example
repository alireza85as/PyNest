# Copy this file to .env and fill in your values.

# LLM provider: "openai" (default, works with any OpenAI-compatible API)
# or "gemini" (Google Gemini).
# LLM_PROVIDER=openai

# --- OpenAI provider (default) ---
# Required for "describe" mode.
# OPENAI_API_KEY=sk-your-key-here
# Optional: any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: model to use.
# OPENAI_MODEL=gpt-4o-mini

# --- Gemini provider ---
# Required when LLM_PROVIDER=gemini.
# GEMINI_API_KEY=your-google-ai-studio-key-here
# Optional: model to use.
# GEMINI_MODEL=gemini-3.1-flash
